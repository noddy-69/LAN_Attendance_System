# ══════════════════════════════════════════════════════════
# Attendance & Workforce Management System — Environment
# Copy to .env and fill in real values before running.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════

# ── Deployment ────────────────────────────────────────────
# local     → office LAN, HTTP only
# local-ssl → office LAN, HTTPS (set automatically by setup-https.ps1)
DEPLOYMENT_MODE=local

# ── URLs ─────────────────────────────────────────────────
# Office LAN, e.g. http://192.168.x.x  (update-ip.bat finds the PC's LAN IP)
BASE_URL=http://192.168.1.100
NEXT_PUBLIC_API_URL=http://192.168.1.100/api/v1

# Nginx port bindings (change if 80/443 are taken)
HTTP_PORT=80
HTTPS_PORT=443

# ── Database ─────────────────────────────────────────────
POSTGRES_DB=attendance
POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=CHANGE_THIS_strong_db_password

# asyncpg DSN — host must match the compose service name
DATABASE_URL=postgresql+asyncpg://attendance_user:CHANGE_THIS_strong_db_password@postgres:5432/attendance

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT Security ─────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_to_a_64_char_hex_secret_for_jwt_signing_xxxxxxxxxxxxx
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set true in production when serving over HTTPS so the refresh-token cookie
# gets the Secure flag and is not sent over plain HTTP.
COOKIE_SECURE=false

# ── MinIO (S3-compatible object storage) ─────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_THIS_minio_password_min_8_chars
MINIO_BUCKET_ATTENDANCE=attendance-proofs
MINIO_SECURE=false          # set true when MinIO is behind HTTPS

# ── WhatsApp (Meta Cloud API — optional) ──────────────────
# Best set in Admin -> Settings -> Notifications (stored in the DB). These are env
# fallbacks. Create an app at https://developers.facebook.com -> WhatsApp, then paste
# the access token + Phone Number ID + an approved template whose body is one {{1}} var.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=en_US
WHATSAPP_API_VERSION=v21.0

# ── SMTP (email notifications — optional) ─────────────────
# In-app notifications always work. Configure SMTP to also email staff.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=              # use App Password if 2FA is on
SMTP_FROM=noreply@yourcompany.com
SMTP_TLS=true

# ── Face Recognition ─────────────────────────────────────
# CP Plus RTSP format:
# rtsp://admin:{password}@{camera_ip}:554/cam/realmonitor?channel=1&subtype=0
# Also accepts a video file path or a webcam index ("0") for testing.
# Leave empty to disable camera capture (enrollment API still works).
ENTRY_CAMERA_URL=rtsp://admin:password@192.168.1.10:554/cam/realmonitor?channel=1&subtype=0
EXIT_CAMERA_URL=rtsp://admin:password@192.168.1.11:554/cam/realmonitor?channel=1&subtype=0

# Machine account the face service uses to authenticate camera events.
# The backend seed creates this user (role "service", permission attendance:write).
# CHANGE THE PASSWORD in production — keep both values in sync (they are read
# by the backend seed and by the face-recognition container).
SERVICE_ACCOUNT_EMAIL=face-service@attendance.app
SERVICE_ACCOUNT_PASSWORD=FaceService@1234

# Branch UUID that camera events are attributed to.
# Leave empty for single-branch installs — the face service then uses the
# service account's own branch automatically.
FACE_BRANCH_ID=
FACE_CONFIDENCE_THRESHOLD=0.95
FACE_COOLDOWN_SECONDS=300   # 5-minute cooldown per employee per camera
FRAME_SKIP=3                # process 1 of every N frames (CPU optimisation)

# Liveness / anti-spoofing (defends against printed-photo & screen-replay attacks).
# Off by default. To enable: drop MiniFASNet ONNX model(s) into the face-service
# anti-spoof model dir (default /opt/insightface/antispoof) and set =true.
FACE_ANTISPOOF_ENABLED=false
FACE_ANTISPOOF_THRESHOLD=0.6
# Selfie check-in turns passive anti-spoofing ON by default, independent of the
# camera flag above. With a MiniFASNet model present it rejects photo/screen
# attacks on the selfie; with no model it fails open (active head-movement
# liveness still applies). Set =false to opt the selfie path out.
SELFIE_ANTISPOOF_ENABLED=true

# ── Attendance Engine ─────────────────────────────────────
# Server-side cooldown guard: reject duplicate events of the same type
# within this window (seconds). Should match FACE_COOLDOWN_SECONDS.
ATTENDANCE_COOLDOWN_SECONDS=300

# ── Self-service selfie check-in ──────────────────────────
# Employees mark attendance from their own phone with a live selfie (1:1 face
# match + head-movement liveness). Comma-separated CIDRs treated as the office
# LAN; leave empty so any private/loopback address counts as on-LAN (suits a
# single-PC LAN install). The LAN check is flag-and-audit only — off-LAN
# check-ins are still recorded, just flagged in the audit log.
# NOTE: phone camera access requires HTTPS (run setup-https.ps1 and trust the
# cert on phones) — it works on http://localhost only on the host PC.
SELFIE_ALLOWED_SUBNETS=
# Internal URL the backend uses to reach the face service for liveness/match.
FACE_SERVICE_URL=http://face-recognition:8001

# ── Biometric — ZKTeco K40 ────────────────────────────────
# Device pushes to POST /api/v1/attendance/biometric-event
# state mapping: 0 = check-in, 1 = check-out (ZKTeco ADMS default)
BIOMETRIC_CHECKIN_STATE=0
# Set true in production: the webhook then only accepts payloads whose device
# serial ("sn") matches a device registered in the Admin portal. Recommended.
BIOMETRIC_REQUIRE_REGISTERED_DEVICE=false

# ── Payroll Defaults ─────────────────────────────────────
DEFAULT_ALLOWED_LATE_COUNT=3
DEFAULT_LATE_PENALTY_PAISE=20000   # ₹200 stored as paise (integer)
