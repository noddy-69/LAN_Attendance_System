# Python bytecode
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd

# Distribution / packaging
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking / linting caches
.mypy_cache/
.ruff_cache/

# Environment files — NEVER bake secrets into an image layer
.env
.env.*
!.env.example

# Version control
.git/
.gitignore
.gitattributes

# Docker meta-files (no need to copy into themselves)
Dockerfile
.dockerignore

# IDE
.vscode/
.idea/
*.swp
*.swo
